{
  "name": "open-auther",
  "version": "1.1.1",
  "description": "Professional-grade authentication and model routing library",
  "keywords": [
    "openai-compatible",
    "oauth",
    "model-router",
    "gateway",
    "chatgpt",
    "codex"
  ],
  "homepage": "https://github.com/ahmadrz-ai/Open-Auther#readme",
  "bugs": {
    "url": "https://github.com/ahmadrz-ai/Open-Auther/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmadrz-ai/Open-Auther.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.mjs",
      "require": "./dist/cli.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "open-auther": "dist/cli.js",
    "openauther": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format cjs,esm --dts --clean && node scripts/copy-ui.mjs",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm run test"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
